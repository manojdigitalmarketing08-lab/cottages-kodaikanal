# Clean-URL rewrite for Apache (XAMPP/WAMP/MAMP local servers, and most
# shared hosts). Mirrors router.php, which handles the same job when
# running via PHP's own built-in server (php -S localhost:8000 router.php).

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Real files and directories are served as-is (css, js, images,
  # partials, and the .html files themselves).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send a bare ".html" request to its extension-less clean URL, so the
  # site only ever exposes one canonical address per page.
  RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /some-page -> some-page.html
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*?)/?$ $1.html [L]
</IfModule>
